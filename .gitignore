# Папки, которые Python создаёт сам. В репозиторий им не надо:
# это результат работы, он пересоздаётся из исходников.
__pycache__/
*.pyc

# Виртуальное окружение. Своё у каждого, в общий репозиторий не кладётся.
.venv/
venv/

# Настройки редактора. Держим репозиторий чистым от личного.
.vscode/
.idea/

# Файлы, которые создают сами программы урока 4-5. Это результат запуска,
# а не исходник: пропадут — появятся заново.
# **/ в начале значит «такая папка где угодно»: и session3/urok4, и старая
# urok4 в корне, где эти файлы остались у тех, кто запускал программы
# до раскладки по занятиям.
**/urok4/note.txt
**/urok4/books.csv
**/urok4/my_books.csv
**/urok5/tasks.csv

# База, которую planv.py создаёт при каждом запуске. Пересоздаётся сама.
**/zanyatie5/kiber.db
